<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- DeckOut's background part, registered by the app with SMAppService.agent(plistName:).
         launchd keeps the job definition it registered: change anything here and the label must change too. -->
    <key>Label</key>
    <string>@LABEL@</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/DeckOutAgent</string>
    <key>ProgramArguments</key>
    <array>
        <string>DeckOutAgent</string>
        <string>--mach-service</string>
        <string>@LABEL@</string>
    </array>
    <key>MachServices</key>
    <dict>
        <key>@LABEL@</key>
        <true/>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>@BUNDLE_ID@</string>
    </array>
</dict>
</plist>
