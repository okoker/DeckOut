<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Developer ID builds only (make signed). Keys on the deck run people's commands, which send Apple Events through
     osascript (driving iTerm2, Chrome, System Events); under the hardened runtime that needs this entitlement. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
